# ========================= ZT-AI-CORE .gitignore =========================
# Rust
**/target/
**/*.rs.bk
*.pdb
Cargo.lock.bak

# Go
**/bin/
**/vendor/
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out
go.work
go.work.sum

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
*.egg
.eggs/
build/
dist/
wheels/
*.whl
.venv/
venv/
env/
.python-version
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
*.cover
.hypothesis/
.tox/
.nox/
pip-wheel-metadata/

# C / C++ (eBPF, seccomp harnesses)
*.o
*.obj
*.a
*.la
*.lo
*.d
*.gch
*.out
*.app
*.i
*.s
*.ko
*.elf
*.map

# SQLite / локальные БД (WORM-лог, WAL, векторные БД, nonce-кэш)
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
*.sqlite3-journal
*.wal
*.log
chroma_data/
pgdata/

# Protobuf / сгенерированный codegen
*_pb2.py
*_pb2_grpc.py
*_pb2.pyi
*.pb.go
*.pb.cc
*.pb.h
*_pb.rs
gen/
api/gen/

# Ключи и секреты — НИКОГДА не коммитить (политика F-H-03)
keys/
*.pem
*.key
*.crt
*.cer
*.der
*.p12
*.pfx
*.jks
*.tpm
secrets/
.env
.env.*
!.env.example

# Docker / compose артефакты
.docker/
docker-volumes/
*.pid

# IDE / редакторы
.idea/
.vscode/
*.iml
*.ipr
*.iws
*.swp
*.swo
*~
.DS_Store
Thumbs.db
.project
.classpath
.settings/

# ОС / временное
tmp/
temp/
/var/
core
core.*
